# ---------- Ollama Cloud (required) ----------
# Get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_key
OLLAMA_BASE_URL=https://ollama.com

# Reasoning / answer model (text)
OLLAMA_CHAT_MODEL=gpt-oss:120b
# Fast model for router / rewriter / grader / re-ranker.
# Pick one that does NOT emit hidden reasoning: on gpt-oss the thinking tokens
# eat the generation budget and the JSON never gets written (~25s and flaky).
OLLAMA_FAST_MODEL=nemotron-3-nano:30b
# Vision model used to read scanned PDFs and photos of documents
OLLAMA_VISION_MODEL=gemma4:31b
# Embedding model. Ollama Cloud has no embedding endpoint today, so leave this
# blank: the app falls back to its built-in local encoder and retrieval still works.
OLLAMA_EMBED_MODEL=

# ---------- Upstash Redis (optional; falls back to in-memory) ----------
# If you add Upstash through the Vercel marketplace integration it injects
# KV_REST_API_URL / KV_REST_API_TOKEN instead, and the app reads those too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- App ----------
# Max characters of a single uploaded document we will index (keeps the browser snappy)
NEXT_PUBLIC_MAX_DOC_CHARS=400000
